{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wander-mark",
  "version": "2.8.4",
  "identifier": "ru.limiteddissolve.wandermark",
  "build": {
    "frontendDist": "../../client/dist-tauri",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd ../client dev:tauri",
    "beforeBuildCommand": "bun run --cwd ../client build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "wander-mark",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
