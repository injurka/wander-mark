{
  "name": "@limiteddissolve/wander-mark-cli",
  "type": "module",
  "version": "1.1.2",
  "description": "CLI tool for building and deploying Wander Mark static sites",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/injurka/wander-mark.git",
    "directory": "apps/cli"
  },
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    }
  },
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "bin": {
    "wander-mark": "./dist/index.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "node ./dist/index.js",
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev": "bun --watch src/index.ts",
    "--------------------------------<    PUBLISH    >---------------------------------": "",
    "publish:npm": "npm publish --access public",
    "--------------------------------<      BUILD     >--------------------------------": "",
    "prepack": "npm run build",
    "prebuild": "node ./scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "dotenv-safe": "^8.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "7.7.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.10",
    "eslint": "10.0.3",
    "eslint-plugin-format": "2.0.1",
    "typescript": "5.9.3"
  }
}
