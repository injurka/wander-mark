{
  "name": "@injurka/wander-mark-cli",
  "type": "module",
  "version": "1.0.0",
  "description": "CLI tool for building and deploying Wander Mark static sites",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/injurka/wander-mark.git",
    "directory": "apps/cli"
  },
  "bin": {
    "wander-mark": "./dist/index.js"
  },
  "files": [
    "LICENSE",
    "dist",
    "readme.md"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev": "bun --watch src/index.ts",
    "--------------------------------<    PUBLISH    >---------------------------------": "",
    "publish:npm": "bun run build && npm publish --access public",
    "publish:jsr": "npx jsr publish",
    "publish:jsr:dry": "npx jsr publish --dry-run",
    "--------------------------------<      BUILD     >--------------------------------": "",
    "prepack": "bun run build",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --no-minify",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "dotenv-safe": "^8.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "7.7.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.10",
    "eslint": "10.0.3",
    "eslint-plugin-format": "2.0.1",
    "typescript": "5.9.3"
  }
}
