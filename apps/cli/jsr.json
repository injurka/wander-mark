{
  "name": "@injurka/wander-mark-cli",
  "version": "1.1.1",
  "description": "CLI tool for building and deploying Wander Mark static sites",
  "exports": {
    ".": "./src/mod.ts",
    "./bin": "./src/index.ts"
  },
  "bin": {
    "wander-mark": "./src/index.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ]
  },
  "runtimeCompat": {
    "bun": "compatible",
    "node": "compatible",
    "deno": "unsupported",
    "workerd": "unsupported"
  }
}
